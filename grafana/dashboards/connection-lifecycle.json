{
    "uid":  "pgstat-connection-lifecycle",
    "title":  "pgstat \u2014 Connection Lifecycle",
    "tags":  [
                 "pgstat",
                 "connection"
             ],
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  1,
    "refresh":  "5m",
    "time":  {
                 "from":  "now-24h",
                 "to":  "now"
             },
    "templating":  {
                       "list":  [
                                    {
                                        "query":  "select distinct coalesce(service_group, \u0027(none)\u0027) from control.instance_inventory where is_active order by 1",
                                        "datasource":  {
                                                           "type":  "postgres",
                                                           "uid":  "pgstat"
                                                       },
                                        "includeAll":  true,
                                        "name":  "service_group",
                                        "type":  "query",
                                        "label":  "Service Group",
                                        "multi":  true,
                                        "refresh":  1
                                    },
                                    {
                                        "query":  "select display_name as __text, instance_pk::text as __value from control.instance_inventory where is_active and (service_group in ($service_group) or \u0027All\u0027 in ($service_group) or service_group is null) order by display_name",
                                        "datasource":  {
                                                           "type":  "postgres",
                                                           "uid":  "pgstat"
                                                       },
                                        "includeAll":  true,
                                        "name":  "instance",
                                        "type":  "query",
                                        "label":  "Instance",
                                        "multi":  true,
                                        "refresh":  1
                                    },
                                    {
                                        "query":  "select distinct datname as __text, datname as __value from dim.database_ref where not is_template and (instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) order by datname",
                                        "datasource":  {
                                                           "type":  "postgres",
                                                           "uid":  "pgstat"
                                                       },
                                        "includeAll":  true,
                                        "name":  "database",
                                        "type":  "query",
                                        "label":  "Database",
                                        "multi":  true,
                                        "refresh":  1
                                    }
                                ]
                   },
    "panels":  [
                   {
                       "id":  1,
                       "title":  "Total Active Connections",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  8,
                                       "x":  0,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "decimals":  0,
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "green",
                                                                                                 "value":  null
                                                                                             },
                                                                                             {
                                                                                                 "color":  "yellow",
                                                                                                 "value":  100
                                                                                             },
                                                                                             {
                                                                                                 "color":  "red",
                                                                                                 "value":  500
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         },
                                       "textMode":  "value_and_name",
                                       "colorMode":  "background",
                                       "graphMode":  "none"
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select count(*) as \"Active Connections\" from fact.pg_activity_snapshot a join control.instance_inventory i on i.instance_pk = a.instance_pk where a.snapshot_ts = (select max(snapshot_ts) from fact.pg_activity_snapshot) and a.state = \u0027active\u0027 and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null)",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  2,
                       "title":  "Total Idle in Transaction",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  8,
                                       "x":  8,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "decimals":  0,
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "green",
                                                                                                 "value":  null
                                                                                             },
                                                                                             {
                                                                                                 "color":  "yellow",
                                                                                                 "value":  20
                                                                                             },
                                                                                             {
                                                                                                 "color":  "red",
                                                                                                 "value":  50
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         },
                                       "textMode":  "value_and_name",
                                       "colorMode":  "background",
                                       "graphMode":  "none"
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select count(*) as \"Idle in Tx\" from fact.pg_activity_snapshot a join control.instance_inventory i on i.instance_pk = a.instance_pk where a.snapshot_ts = (select max(snapshot_ts) from fact.pg_activity_snapshot) and a.state = \u0027idle in transaction\u0027 and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null)",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  3,
                       "title":  "Idle in Tx Ratio (%)",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  8,
                                       "x":  16,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent",
                                                            "decimals":  1,
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "green",
                                                                                                 "value":  null
                                                                                             },
                                                                                             {
                                                                                                 "color":  "yellow",
                                                                                                 "value":  20
                                                                                             },
                                                                                             {
                                                                                                 "color":  "red",
                                                                                                 "value":  50
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         },
                                       "textMode":  "value_and_name",
                                       "colorMode":  "background",
                                       "graphMode":  "none"
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select case when coalesce(sum(d.session_time_ms_delta), 0) = 0 then 0 else round((coalesce(sum(d.idle_in_transaction_time_ms_delta), 0)::numeric / nullif(sum(d.session_time_ms_delta), 0) * 100)::numeric, 1) end as \"Idle Tx %\" from fact.pg_database_delta d join control.instance_inventory i on i.instance_pk = d.instance_pk where d.sample_ts \u003e= now() - interval \u00271 hour\u0027 and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) and (\u0027All\u0027 in ($database) or d.datname in ($database))",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  10,
                       "title":  "Per-Instance Connection Profile",
                       "type":  "table",
                       "gridPos":  {
                                       "h":  9,
                                       "w":  24,
                                       "x":  0,
                                       "y":  4
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "links":  [
                                                                          {
                                                                              "title":  "Instance Detail\u0027a git",
                                                                              "url":  "/grafana/d/pgstat-instance-detail?var-instance=${__data.fields.instance_pk}\u0026from=${__from}\u0026to=${__to}"
                                                                          }
                                                                      ]
                                                        },
                                           "overrides":  [
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "instance_pk"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "custom.hidden",
                                                                                        "value":  true
                                                                                    }
                                                                                ]
                                                             },
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "idle_tx_pct"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "percent"
                                                                                    },
                                                                                    {
                                                                                        "id":  "thresholds",
                                                                                        "value":  {
                                                                                                      "mode":  "absolute",
                                                                                                      "steps":  [
                                                                                                                    {
                                                                                                                        "color":  "green",
                                                                                                                        "value":  null
                                                                                                                    },
                                                                                                                    {
                                                                                                                        "color":  "red",
                                                                                                                        "value":  30
                                                                                                                    }
                                                                                                                ]
                                                                                                  }
                                                                                    },
                                                                                    {
                                                                                        "id":  "custom.displayMode",
                                                                                        "value":  "color-background"
                                                                                    }
                                                                                ]
                                                             }
                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "rawSql":  "with latest as (select max(snapshot_ts) as ts from fact.pg_activity_snapshot) select a.instance_pk, i.display_name as instance, count(*) filter (where a.state = \u0027active\u0027) as active, count(*) filter (where a.state = \u0027idle\u0027) as idle, count(*) filter (where a.state = \u0027idle in transaction\u0027) as idle_in_tx, count(*) as total, round(count(*) filter (where a.state = \u0027idle in transaction\u0027)::numeric / nullif(count(*), 0) * 100, 1) as idle_tx_pct from fact.pg_activity_snapshot a join control.instance_inventory i on i.instance_pk = a.instance_pk cross join latest l where a.snapshot_ts = l.ts and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) group by a.instance_pk, i.display_name order by idle_tx_pct desc",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  11,
                       "title":  "Top Idle in Tx Backends",
                       "type":  "table",
                       "gridPos":  {
                                       "h":  9,
                                       "w":  24,
                                       "x":  0,
                                       "y":  13
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "links":  [
                                                                          {
                                                                              "title":  "Instance Detail\u0027a git",
                                                                              "url":  "/grafana/d/pgstat-instance-detail?var-instance=${__data.fields.instance_pk}\u0026from=${__from}\u0026to=${__to}"
                                                                          }
                                                                      ]
                                                        },
                                           "overrides":  [
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "instance_pk"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "custom.hidden",
                                                                                        "value":  true
                                                                                    }
                                                                                ]
                                                             },
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "idle_seconds"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "s"
                                                                                    }
                                                                                ]
                                                             }
                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "rawSql":  "with latest as (select max(snapshot_ts) as ts from fact.pg_activity_snapshot) select a.instance_pk, i.display_name as instance, a.pid, coalesce(a.usename, \u0027\u0027) as usename, coalesce(a.application_name, \u0027\u0027) as application_name, a.state, round(extract(epoch from (l.ts - coalesce(a.state_change, l.ts)))) as idle_seconds from fact.pg_activity_snapshot a join control.instance_inventory i on i.instance_pk = a.instance_pk cross join latest l where a.snapshot_ts = l.ts and a.state = \u0027idle in transaction\u0027 and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) order by idle_seconds desc limit 50",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  20,
                       "title":  "Fleet State Distribution Over Time",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  9,
                                       "w":  24,
                                       "x":  0,
                                       "y":  22
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "custom":  {
                                                                           "drawStyle":  "line",
                                                                           "lineWidth":  1,
                                                                           "fillOpacity":  80,
                                                                           "stacking":  {
                                                                                            "mode":  "normal",
                                                                                            "group":  "A"
                                                                                        },
                                                                           "showPoints":  "never"
                                                                       }
                                                        }
                                       },
                       "options":  {
                                       "legend":  {
                                                      "displayMode":  "list",
                                                      "placement":  "bottom"
                                                  },
                                       "tooltip":  {
                                                       "mode":  "multi"
                                                   }
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select $__timeGroupAlias(a.snapshot_ts, $__interval), coalesce(a.state, \u0027unknown\u0027) as metric, count(*) as value from fact.pg_activity_snapshot a join control.instance_inventory i on i.instance_pk = a.instance_pk where $__timeFilter(a.snapshot_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) group by 1, coalesce(a.state, \u0027unknown\u0027) order by 1",
                                           "format":  "time_series"
                                       }
                                   ]
                   }
               ]
}