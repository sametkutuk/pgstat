{
    "uid":  "pgstat-database-tables",
    "title":  "pgstat â€” Database \u0026 Tables Overview",
    "description":  "Fleet genelinde en aktif DB\u0027ler ve tablolar (cross-instance). En cok yazma/okuma yapan, deadlock/conflict yasayan instance+DB. Click â†’ Instance Detail.",
    "tags":  [
                 "pgstat",
                 "fleet"
             ],
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  2,
    "refresh":  "1m",
    "time":  {
                 "from":  "now-6h",
                 "to":  "now"
             },
    "templating":  {
                       "list":  [
                                    {
                                        "query":  "select distinct coalesce(service_group, \u0027(none)\u0027) from control.instance_inventory where is_active order by 1",
                                        "datasource":  {
                                                           "type":  "postgres",
                                                           "uid":  "pgstat"
                                                       },
                                        "includeAll":  true,
                                        "name":  "service_group",
                                        "type":  "query",
                                        "label":  "Service Group",
                                        "multi":  true,
                                        "refresh":  1
                                    },
                                    {
                                        "query":  "select display_name as __text, instance_pk::text as __value from control.instance_inventory where is_active and (service_group in ($service_group) or \u0027All\u0027 in ($service_group) or service_group is null) order by display_name",
                                        "datasource":  {
                                                           "type":  "postgres",
                                                           "uid":  "pgstat"
                                                       },
                                        "includeAll":  true,
                                        "name":  "instance",
                                        "type":  "query",
                                        "label":  "Instance",
                                        "multi":  true,
                                        "refresh":  1
                                    },
                                    {
                                        "query":  "select distinct datname as __text, datname as __value from dim.database_ref where not is_template and (instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) order by datname",
                                        "datasource":  {
                                                           "type":  "postgres",
                                                           "uid":  "pgstat"
                                                       },
                                        "includeAll":  true,
                                        "name":  "database",
                                        "type":  "query",
                                        "label":  "Database",
                                        "multi":  true,
                                        "refresh":  1
                                    }
                                ]
                   },
    "panels":  [
                   {
                       "id":  1,
                       "title":  "Toplam DB (fleet)",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  6,
                                       "x":  0,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        }
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         }
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select count(distinct (d.instance_pk, d.dbid)) as value from fact.pg_database_delta d join control.instance_inventory i on i.instance_pk = d.instance_pk where d.sample_ts \u003e now() - interval \u00275 minutes\u0027 and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) and (\u0027All\u0027 in ($database) or d.datname in ($database))",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  2,
                       "title":  "Toplam Conflict (range)",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  6,
                                       "x":  6,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "color":  "yellow",
                                                                                                 "value":  1
                                                                                             },
                                                                                             {
                                                                                                 "color":  "red",
                                                                                                 "value":  100
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         }
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select coalesce(sum(d.conflicts_delta), 0) as value from fact.pg_database_delta d join control.instance_inventory i on i.instance_pk = d.instance_pk where $__timeFilter(d.sample_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) and (\u0027All\u0027 in ($database) or d.datname in ($database))",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  3,
                       "title":  "Toplam Deadlock (range)",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  6,
                                       "x":  12,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "green"
                                                                                             },
                                                                                             {
                                                                                                 "color":  "red",
                                                                                                 "value":  1
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         }
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select coalesce(sum(d.deadlocks_delta), 0) as value from fact.pg_database_delta d join control.instance_inventory i on i.instance_pk = d.instance_pk where $__timeFilter(d.sample_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) and (\u0027All\u0027 in ($database) or d.datname in ($database))",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  4,
                       "title":  "Toplam Temp File (range)",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  6,
                                       "x":  18,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        }
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         }
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select coalesce(sum(d.temp_files_delta), 0) as value from fact.pg_database_delta d join control.instance_inventory i on i.instance_pk = d.instance_pk where $__timeFilter(d.sample_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) and (\u0027All\u0027 in ($database) or d.datname in ($database))",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  10,
                       "title":  "Top 30 Database (cross-instance, range içi)",
                       "type":  "table",
                       "gridPos":  {
                                       "h":  14,
                                       "w":  24,
                                       "x":  0,
                                       "y":  4
                                   },
                       "description":  "Fleet\u0027teki en aktif DB\u0027ler. Hangi instance\u0027da hangi DB\u0027de ne kadar yük var.",
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "links":  [
                                                                          {
                                                                              "title":  "Instance Detail\u0027a git",
                                                                              "url":  "/grafana/d/pgstat-instance-detail?var-instance=${__data.fields.instance_pk}\u0026from=${__from}\u0026to=${__to}"
                                                                          }
                                                                      ]
                                                        },
                                           "overrides":  [
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "disk_read"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "bytes"
                                                                                    }
                                                                                ]
                                                             },
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "temp_bytes"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "bytes"
                                                                                    }
                                                                                ]
                                                             },
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "cache_hit_pct"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "percent"
                                                                                    },
                                                                                    {
                                                                                        "id":  "thresholds",
                                                                                        "value":  {
                                                                                                      "mode":  "absolute",
                                                                                                      "steps":  [
                                                                                                                    {
                                                                                                                        "color":  "red"
                                                                                                                    },
                                                                                                                    {
                                                                                                                        "color":  "yellow",
                                                                                                                        "value":  90
                                                                                                                    },
                                                                                                                    {
                                                                                                                        "color":  "green",
                                                                                                                        "value":  95
                                                                                                                    }
                                                                                                                ]
                                                                                                  }
                                                                                    },
                                                                                    {
                                                                                        "id":  "custom.cellOptions",
                                                                                        "value":  {
                                                                                                      "type":  "color-background",
                                                                                                      "mode":  "gradient"
                                                                                                  }
                                                                                    }
                                                                                ]
                                                             }
                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "rawSql":  "select i.instance_pk, i.display_name as instance, d.datname as database, sum(d.xact_commit_delta) as commits, sum(d.xact_rollback_delta) as rollbacks, sum(d.tup_inserted_delta) as inserts, sum(d.tup_updated_delta) as updates, sum(d.tup_deleted_delta) as deletes, sum(d.blks_read_delta) * 8192 as disk_read, round(100.0 * sum(d.blks_hit_delta)::numeric / nullif(sum(d.blks_hit_delta + d.blks_read_delta), 0), 1) as cache_hit_pct, sum(d.temp_bytes_delta) as temp_bytes, sum(d.deadlocks_delta) as deadlocks, sum(d.conflicts_delta) as conflicts from fact.pg_database_delta d join control.instance_inventory i on i.instance_pk = d.instance_pk where $__timeFilter(d.sample_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) and (\u0027All\u0027 in ($database) or d.datname in ($database)) group by i.instance_pk, i.display_name, d.datname order by commits desc nulls last limit 30",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  20,
                       "title":  "Top 50 Tablo â€” En Çok Yazma (cross-instance, range içi)",
                       "type":  "table",
                       "gridPos":  {
                                       "h":  14,
                                       "w":  24,
                                       "x":  0,
                                       "y":  18
                                   },
                       "description":  "Fleet\u0027teki en aktif yazılan tablolar. instance Ã— tablo kombinasyonu.",
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "links":  [
                                                                          {
                                                                              "title":  "Instance Detail\u0027a git",
                                                                              "url":  "/grafana/d/pgstat-instance-detail?var-instance=${__data.fields.instance_pk}\u0026from=${__from}\u0026to=${__to}"
                                                                          }
                                                                      ]
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "rawSql":  "select i.instance_pk, i.display_name as instance, t.schemaname || \u0027.\u0027 || t.relname as relation, sum(t.n_tup_ins_delta) as inserts, sum(t.n_tup_upd_delta) as updates, sum(t.n_tup_del_delta) as deletes, sum(t.n_tup_hot_upd_delta) as hot_updates, sum(t.seq_scan_delta) as seq_scans, sum(t.idx_scan_delta) as idx_scans from fact.pg_table_stat_delta t join control.instance_inventory i on i.instance_pk = t.instance_pk where $__timeFilter(t.sample_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) group by i.instance_pk, i.display_name, t.schemaname, t.relname having sum(t.n_tup_ins_delta + t.n_tup_upd_delta + t.n_tup_del_delta) \u003e 0 order by sum(t.n_tup_ins_delta + t.n_tup_upd_delta + t.n_tup_del_delta) desc nulls last limit 50",
                                           "format":  "table"
                                       }
                                   ]
                   }
               ]
}