                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select count(*) as value from fact.pg_progress_snapshot p join control.instance_inventory i on i.instance_pk = p.instance_pk where p.snapshot_ts \u003e now() - interval \u00275 minutes\u0027 and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null)",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  10,
                       "title":  "Instance Bazlı Aktivite Özet — tıkla, detaya git",
                       "type":  "table",
                       "gridPos":  {
                                       "h":  14,
                                       "w":  24,
                                       "x":  0,
                                       "y":  4
                                   },
                       "description":  "Her instance için anlık aktivite/idle/lock/vacuum sayıları. Bir satıra tıklayınca Instance Detail açılır.",
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "links":  [
                                                                          {
                                                                              "title":  "Instance Detail\u0027a git",
                                                                              "url":  "/grafana/d/pgstat-instance-detail?var-instance=${__data.fields.instance_pk}\u0026from=${__from}\u0026to=${__to}"
                                                                          }
                                                                      ]
                                                        },
                                           "overrides":  [
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "idle_tx"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "thresholds",
                                                                                        "value":  {
                                                                                                      "mode":  "absolute",
                                                                                                      "steps":  [
                                                                                                                    {
                                                                                                                        "color":  "green"
                                                                                                                    },
                                                                                                                    {
                                                                                                                        "color":  "yellow",
                                                                                                                        "value":  5
                                                                                                                    },
                                                                                                                    {
                                                                                                                        "color":  "red",
                                                                                                                        "value":  20
                                                                                                                    }
                                                                                                                ]
                                                                                                  }
                                                                                    },
                                                                                    {
                                                                                        "id":  "custom.cellOptions",
                                                                                        "value":  {
                                                                                                      "type":  "color-background"
                                                                                                  }
                                                                                    }
                                                                                ]
                                                             },
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "bekleyen_lock"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "thresholds",
                                                                                        "value":  {
                                                                                                      "mode":  "absolute",
                                                                                                      "steps":  [
                                                                                                                    {
                                                                                                                        "color":  "green"
                                                                                                                    },
                                                                                                                    {
                                                                                                                        "color":  "yellow",
                                                                                                                        "value":  1
                                                                                                                    },
                                                                                                                    {
                                                                                                                        "color":  "red",
                                                                                                                        "value":  5
                                                                                                                    }
                                                                                                                ]
                                                                                                  }
                                                                                    },
                                                                                    {
                                                                                        "id":  "custom.cellOptions",
                                                                                        "value":  {
                                                                                                      "type":  "color-background"
                                                                                                  }
                                                                                    }
                                                                                ]
                                                             }
                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "rawSql":  "with active as (select instance_pk, count(*) filter (where state=\u0027active\u0027) as active_cnt, count(*) filter (where state=\u0027idle\u0027) as idle_cnt, count(*) filter (where state=\u0027idle in transaction\u0027) as idle_tx_cnt, count(*) filter (where state=\u0027active\u0027 and wait_event_type is not null) as waiting_cnt from fact.pg_activity_snapshot where snapshot_ts \u003e now() - interval \u00275 minutes\u0027 group by instance_pk), locks as (select instance_pk, count(*) filter (where granted = false) as waiting_locks from fact.pg_lock_snapshot where snapshot_ts \u003e now() - interval \u00275 minutes\u0027 group by instance_pk), prog as (select instance_pk, count(*) as prog_cnt from fact.pg_progress_snapshot where snapshot_ts \u003e now() - interval \u00275 minutes\u0027 group by instance_pk) select i.instance_pk, i.display_name as instance, coalesce(i.service_group, \u0027—\u0027) as group_name, coalesce(a.active_cnt, 0) as aktif, coalesce(a.idle_cnt, 0) as idle, coalesce(a.idle_tx_cnt, 0) as idle_tx, coalesce(a.waiting_cnt, 0) as wait_event, coalesce(l.waiting_locks, 0) as bekleyen_lock, coalesce(p.prog_cnt, 0) as vacuum_progress from control.instance_inventory i left join active a on a.instance_pk = i.instance_pk left join locks l on l.instance_pk = i.instance_pk left join prog p on p.instance_pk = i.instance_pk where i.is_active and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) order by idle_tx desc nulls last, bekleyen_lock desc nulls last, aktif desc",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  20,
                       "title":  "Cross-Instance Uzun Süreli Sorgular (\u003e1 dk)",
                       "type":  "table",
                       "gridPos":  {
                                       "h":  12,
                                       "w":  24,
                                       "x":  0,
                                       "y":  18
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "links":  [
                                                                          {
                                                                              "title":  "Instance Detail\u0027a git",
                                                                              "url":  "/grafana/d/pgstat-instance-detail?var-instance=${__data.fields.instance_pk}\u0026from=${__from}\u0026to=${__to}"
                                                                          }
                                                                      ]
                                                        },
                                           "overrides":  [
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "süre_sn"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "s"
                                                                                    }
                                                                                ]
                                                             }
                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "rawSql":  "select i.instance_pk, i.display_name as instance, a.snapshot_ts, a.pid, a.datname, a.usename as \"user\", a.state, a.wait_event_type, extract(epoch from (a.snapshot_ts - a.query_start))::int as \"süre_sn\", left(a.query, 200) as query from fact.pg_activity_snapshot a join control.instance_inventory i on i.instance_pk = a.instance_pk where a.snapshot_ts \u003e now() - interval \u00275 minutes\u0027 and a.state = \u0027active\u0027 and a.query_start is not null and (a.snapshot_ts - a.query_start) \u003e interval \u00271 minute\u0027 and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) and (\u0027All\u0027 in ($database) or a.datname in ($database)) order by a.query_start asc limit 100",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  21,
                       "title":  "Cross-Instance Bekleyen Lock\u0027lar",
                       "type":  "table",
                       "gridPos":  {
                                       "h":  12,
                                       "w":  24,
                                       "x":  0,
                                       "y":  30
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "links":  [
                                                                          {
                                                                              "title":  "Instance Detail\u0027a git",
                                                                              "url":  "/grafana/d/pgstat-instance-detail?var-instance=${__data.fields.instance_pk}\u0026from=${__from}\u0026to=${__to}"
                                                                          }
                                                                      ]
                                                        },
                                           "overrides":  [
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "bekleme_sn"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "s"
                                                                                    }
                                                                                ]
                                                             }
                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "rawSql":  "with latest as (select instance_pk, max(snapshot_ts) as ts from fact.pg_lock_snapshot where snapshot_ts \u003e now() - interval \u00275 minutes\u0027 group by instance_pk) select i.instance_pk, i.display_name as instance, l.snapshot_ts, l.pid as bekleyen_pid, l.locktype, l.mode, array_to_string(l.blocked_by_pids, \u0027,\u0027) as blocked_by, coalesce(extract(epoch from (l.snapshot_ts - l.waitstart))::int, 0) as bekleme_sn from fact.pg_lock_snapshot l join latest la on la.instance_pk = l.instance_pk and la.ts = l.snapshot_ts join control.instance_inventory i on i.instance_pk = l.instance_pk where l.granted = false and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) order by l.waitstart asc limit 50",
                                           "format":  "table"
                                       }
                                   ]
                   }
               ]
}