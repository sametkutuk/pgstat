{
    "uid":  "pgstat-index-health",
    "title":  "pgstat \u2014 Index Health Overview",
    "tags":  [
                 "pgstat",
                 "index"
             ],
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  1,
    "refresh":  "5m",
    "time":  {
                 "from":  "now-24h",
                 "to":  "now"
             },
    "templating":  {
                       "list":  [
                                    {
                                        "query":  "select distinct coalesce(service_group, \u0027(none)\u0027) from control.instance_inventory where is_active order by 1",
                                        "datasource":  {
                                                           "type":  "postgres",
                                                           "uid":  "pgstat"
                                                       },
                                        "includeAll":  true,
                                        "name":  "service_group",
                                        "type":  "query",
                                        "label":  "Service Group",
                                        "multi":  true,
                                        "refresh":  1
                                    },
                                    {
                                        "query":  "select display_name as __text, instance_pk::text as __value from control.instance_inventory where is_active and (service_group in ($service_group) or \u0027All\u0027 in ($service_group) or service_group is null) order by display_name",
                                        "datasource":  {
                                                           "type":  "postgres",
                                                           "uid":  "pgstat"
                                                       },
                                        "includeAll":  true,
                                        "name":  "instance",
                                        "type":  "query",
                                        "label":  "Instance",
                                        "multi":  true,
                                        "refresh":  1
                                    },
                                    {
                                        "query":  "select distinct datname as __text, datname as __value from dim.database_ref where not is_template and (instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) order by datname",
                                        "datasource":  {
                                                           "type":  "postgres",
                                                           "uid":  "pgstat"
                                                       },
                                        "includeAll":  true,
                                        "name":  "database",
                                        "type":  "query",
                                        "label":  "Database",
                                        "multi":  true,
                                        "refresh":  1
                                    }
                                ]
                   },
    "panels":  [
                   {
                       "id":  1,
                       "title":  "Total Distinct Indexes",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  8,
                                       "x":  0,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "decimals":  0,
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "blue",
                                                                                                 "value":  null
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         },
                                       "textMode":  "value_and_name",
                                       "colorMode":  "background",
                                       "graphMode":  "none"
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select count(distinct (ix.instance_pk, ix.dbid, ix.index_relid)) as \"Total Indexes\" from fact.pg_index_stat_delta ix join control.instance_inventory i on i.instance_pk = ix.instance_pk where ix.sample_ts \u003e= now() - interval \u00271 hour\u0027 and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null)",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  2,
                       "title":  "Unused Indexes (30d, \u003e100MB)",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  8,
                                       "x":  8,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "decimals":  0,
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "green",
                                                                                                 "value":  null
                                                                                             },
                                                                                             {
                                                                                                 "color":  "yellow",
                                                                                                 "value":  10
                                                                                             },
                                                                                             {
                                                                                                 "color":  "red",
                                                                                                 "value":  50
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         },
                                       "textMode":  "value_and_name",
                                       "colorMode":  "background",
                                       "graphMode":  "none"
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "with idx_usage as (select ix.instance_pk, ix.dbid, ix.index_relid, ix.schemaname, ix.index_relname, coalesce(sum(ix.idx_scan_delta), 0) as total_scans from fact.pg_index_stat_delta ix join control.instance_inventory i on i.instance_pk = ix.instance_pk where ix.sample_ts \u003e= now() - interval \u002730 days\u0027 and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) group by ix.instance_pk, ix.dbid, ix.index_relid, ix.schemaname, ix.index_relname having coalesce(sum(ix.idx_scan_delta), 0) = 0), idx_size as (select rs.instance_pk, rs.dbid, rs.schemaname, rs.relname, rs.index_size_bytes from fact.pg_relation_size_snapshot rs where rs.snapshot_ts = (select max(snapshot_ts) from fact.pg_relation_size_snapshot) and rs.relkind = \u0027i\u0027 and coalesce(rs.index_size_bytes, 0) \u003e 104857600) select count(*) as \"Unused Indexes\" from idx_usage u join idx_size s on s.instance_pk = u.instance_pk and s.dbid = u.dbid and s.schemaname = u.schemaname and s.relname = u.index_relname",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  3,
                       "title":  "Missing Index Suspects",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  8,
                                       "x":  16,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "decimals":  0,
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "green",
                                                                                                 "value":  null
                                                                                             },
                                                                                             {
                                                                                                 "color":  "yellow",
                                                                                                 "value":  5
                                                                                             },
                                                                                             {
                                                                                                 "color":  "red",
                                                                                                 "value":  20
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         },
                                       "textMode":  "value_and_name",
                                       "colorMode":  "background",
                                       "graphMode":  "none"
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select count(*) as \"Missing Index Suspects\" from (select t.instance_pk, t.dbid, t.relid from fact.pg_table_stat_delta t join control.instance_inventory i on i.instance_pk = t.instance_pk where $__timeFilter(t.sample_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) group by t.instance_pk, t.dbid, t.relid having coalesce(sum(t.seq_scan_delta), 0) \u003e coalesce(nullif(sum(t.idx_scan_delta), 0), 1) * 100 and coalesce(sum(t.seq_tup_read_delta), 0) \u003e 100000) sub",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  10,
                       "title":  "Top 30 Missing Index Suspects",
                       "type":  "table",
                       "gridPos":  {
                                       "h":  10,
                                       "w":  24,
                                       "x":  0,
                                       "y":  4
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "links":  [
                                                                          {
                                                                              "title":  "Instance Detail\u0027a git",
                                                                              "url":  "/grafana/d/pgstat-instance-detail?var-instance=${__data.fields.instance_pk}\u0026from=${__from}\u0026to=${__to}"
                                                                          }
                                                                      ]
                                                        },
                                           "overrides":  [
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "table_size_bytes"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "bytes"
                                                                                    }
                                                                                ]
                                                             },
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "instance_pk"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "custom.hidden",
                                                                                        "value":  true
                                                                                    }
                                                                                ]
                                                             }
                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "rawSql":  "with table_usage as (select t.instance_pk, i.display_name as instance, t.dbid, t.schemaname, t.relname, coalesce(sum(t.seq_scan_delta), 0) as seq_scans, coalesce(sum(t.idx_scan_delta), 0) as idx_scans, coalesce(sum(t.seq_tup_read_delta), 0) as seq_tup_read from fact.pg_table_stat_delta t join control.instance_inventory i on i.instance_pk = t.instance_pk where $__timeFilter(t.sample_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) group by t.instance_pk, i.display_name, t.dbid, t.schemaname, t.relname having coalesce(sum(t.seq_scan_delta), 0) \u003e coalesce(nullif(sum(t.idx_scan_delta), 0), 1) * 100 and coalesce(sum(t.seq_tup_read_delta), 0) \u003e 100000), latest_sizes as (select distinct on (rs.instance_pk, rs.dbid, rs.schemaname, rs.relname) rs.instance_pk, rs.dbid, rs.schemaname, rs.relname, rs.table_size_bytes from fact.pg_relation_size_snapshot rs where rs.relkind = \u0027r\u0027 order by rs.instance_pk, rs.dbid, rs.schemaname, rs.relname, rs.snapshot_ts desc) select u.instance_pk, u.instance, u.schemaname || \u0027.\u0027 || u.relname as relation, u.seq_scans, u.idx_scans, case when u.idx_scans = 0 then u.seq_scans else round(u.seq_scans::numeric / nullif(u.idx_scans, 0), 1) end as seq_idx_ratio, u.seq_tup_read, coalesce(rs.table_size_bytes, 0) as table_size_bytes from table_usage u left join latest_sizes rs on rs.instance_pk = u.instance_pk and rs.dbid = u.dbid and rs.schemaname = u.schemaname and rs.relname = u.relname order by u.seq_scans desc limit 30",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  11,
                       "title":  "Top 30 Unused Indexes",
                       "type":  "table",
                       "gridPos":  {
                                       "h":  10,
                                       "w":  24,
                                       "x":  0,
                                       "y":  14
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "links":  [
                                                                          {
                                                                              "title":  "Instance Detail\u0027a git",
                                                                              "url":  "/grafana/d/pgstat-instance-detail?var-instance=${__data.fields.instance_pk}\u0026from=${__from}\u0026to=${__to}"
                                                                          }
                                                                      ]
                                                        },
                                           "overrides":  [
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "index_size_bytes"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "bytes"
                                                                                    }
                                                                                ]
                                                             },
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "instance_pk"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "custom.hidden",
                                                                                        "value":  true
                                                                                    }
                                                                                ]
                                                             }
                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "rawSql":  "with latest_index_sizes as (select distinct on (rs.instance_pk, rs.dbid, rs.schemaname, rs.relname) rs.instance_pk, rs.dbid, rs.schemaname, rs.relname as index_relname, rs.index_size_bytes from fact.pg_relation_size_snapshot rs join control.instance_inventory i on i.instance_pk = rs.instance_pk where rs.relkind = \u0027i\u0027 and coalesce(rs.index_size_bytes, 0) \u003e 104857600 and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) order by rs.instance_pk, rs.dbid, rs.schemaname, rs.relname, rs.snapshot_ts desc), idx_usage as (select ix.instance_pk, ix.dbid, ix.schemaname, ix.table_relname, ix.index_relname, coalesce(sum(ix.idx_scan_delta), 0) as total_scans_30d from fact.pg_index_stat_delta ix join latest_index_sizes s on s.instance_pk = ix.instance_pk and s.dbid = ix.dbid and s.schemaname = ix.schemaname and s.index_relname = ix.index_relname where ix.sample_ts \u003e= now() - interval \u002730 days\u0027 group by ix.instance_pk, ix.dbid, ix.schemaname, ix.table_relname, ix.index_relname having coalesce(sum(ix.idx_scan_delta), 0) = 0) select u.instance_pk, i.display_name as instance, u.index_relname as index_name, u.table_relname as table_name, s.index_size_bytes, u.total_scans_30d from idx_usage u join latest_index_sizes s on s.instance_pk = u.instance_pk and s.dbid = u.dbid and s.schemaname = u.schemaname and s.index_relname = u.index_relname join control.instance_inventory i on i.instance_pk = u.instance_pk order by s.index_size_bytes desc limit 30",
                                           "format":  "table"
                                       }
                                   ]
                   }
               ]
}
