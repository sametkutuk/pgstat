                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
                                                            "decimals":  0
                                                        }
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         }
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select coalesce(sum(d.fsyncs_delta), 0) as value from fact.pg_io_stat_delta d join control.instance_inventory i on i.instance_pk = d.instance_pk where $__timeFilter(d.sample_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null)",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  10,
                       "title":  "Read Hızı per Instance (zaman serisi)",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  0,
                                       "y":  4
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "Bps",
                                                            "custom":  {
                                                                           "drawStyle":  "line",
                                                                           "lineWidth":  1,
                                                                           "fillOpacity":  5
                                                                       }
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "rawSql":  "select $__timeGroupAlias(d.sample_ts, $__interval), i.display_name as metric, sum(d.reads_delta * 8192)::float / nullif(extract(epoch from \u0027$__interval\u0027::interval), 0) as value from fact.pg_io_stat_delta d join control.instance_inventory i on i.instance_pk = d.instance_pk where $__timeFilter(d.sample_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) group by 1, i.display_name order by 1",
                                           "format":  "time_series"
                                       }
                                   ]
                   },
                   {
                       "id":  11,
                       "title":  "Write Hızı per Instance",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  12,
                                       "y":  4
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "Bps",
                                                            "custom":  {
                                                                           "drawStyle":  "line",
                                                                           "lineWidth":  1,
                                                                           "fillOpacity":  5
                                                                       }
                                                        }
                                       },
                       "targets":  [
                                       {
                                           "rawSql":  "select $__timeGroupAlias(d.sample_ts, $__interval), i.display_name as metric, sum(d.writes_delta * 8192)::float / nullif(extract(epoch from \u0027$__interval\u0027::interval), 0) as value from fact.pg_io_stat_delta d join control.instance_inventory i on i.instance_pk = d.instance_pk where $__timeFilter(d.sample_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) group by 1, i.display_name order by 1",
                                           "format":  "time_series"
                                       }
                                   ]
                   },
                   {
                       "id":  20,
                       "title":  "Top 30 Instance Ã— backend_type Ã— context (range içi)",
                       "type":  "table",
                       "gridPos":  {
                                       "h":  14,
                                       "w":  24,
                                       "x":  0,
                                       "y":  13
                                   },
                       "description":  "Hangi instance\u0027da hangi backend_type/context en çok I/O üretmiş.",
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "links":  [
                                                                          {
                                                                              "title":  "Instance Detail\u0027a git",
                                                                              "url":  "/grafana/d/pgstat-instance-detail?var-instance=${__data.fields.instance_pk}\u0026from=${__from}\u0026to=${__to}"
                                                                          }
                                                                      ]
                                                        },
                                           "overrides":  [
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "reads_bytes"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "bytes"
                                                                                    }
                                                                                ]
                                                             },
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "writes_bytes"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "bytes"
                                                                                    }
                                                                                ]
                                                             },
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "extends_bytes"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "bytes"
                                                                                    }
                                                                                ]
                                                             }
                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "rawSql":  "select i.instance_pk, i.display_name as instance, d.backend_type, d.context, sum(d.reads_delta) * 8192 as reads_bytes, sum(d.writes_delta) * 8192 as writes_bytes, sum(d.extends_delta) * 8192 as extends_bytes, sum(d.hits_delta) as hits, sum(d.evictions_delta) as evictions, sum(d.fsyncs_delta) as fsyncs from fact.pg_io_stat_delta d join control.instance_inventory i on i.instance_pk = d.instance_pk where $__timeFilter(d.sample_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null) group by i.instance_pk, i.display_name, d.backend_type, d.context order by reads_bytes desc nulls last limit 30",
                                           "format":  "table"
                                       }
                                   ]
                   }
               ]
