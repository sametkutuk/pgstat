{
    "uid":  "pgstat-io-buffers",
    "title":  "pgstat â€” I/O \u0026 Buffers Overview (PG16+)",
    "description":  "Fleet genelinde pg_stat_io kirilimi. Top read/write yapan instance\u0027lar, backend_type bazli analiz. Click â†’ Instance Detail.",
    "tags":  [
                 "pgstat",
                 "io",
                 "fleet"
             ],
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  2,
    "refresh":  "30s",
    "time":  {
                 "from":  "now-6h",
                 "to":  "now"
             },
    "templating":  {
                       "list":  [
                                    {
                                        "query":  "select distinct coalesce(service_group, \u0027(none)\u0027) from control.instance_inventory where is_active order by 1",
                                        "datasource":  {
                                                           "type":  "postgres",
                                                           "uid":  "pgstat"
                                                       },
                                        "includeAll":  true,
                                        "name":  "service_group",
                                        "type":  "query",
                                        "label":  "Service Group",
                                        "multi":  true,
                                        "refresh":  1
                                    },
                                    {
                                        "query":  "select display_name as __text, instance_pk::text as __value from control.instance_inventory where is_active and (service_group in ($service_group) or \u0027All\u0027 in ($service_group) or service_group is null) order by display_name",
                                        "datasource":  {
                                                           "type":  "postgres",
                                                           "uid":  "pgstat"
                                                       },
                                        "includeAll":  true,
                                        "name":  "instance",
                                        "type":  "query",
                                        "label":  "Instance",
                                        "multi":  true,
                                        "refresh":  1
                                    },
                                    {
                                        "query":  "select distinct datname as __text, datname as __value from dim.database_ref where not is_template and (instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) order by datname",
                                        "datasource":  {
                                                           "type":  "postgres",
                                                           "uid":  "pgstat"
                                                       },
                                        "includeAll":  true,
                                        "name":  "database",
                                        "type":  "query",
                                        "label":  "Database",
                                        "multi":  true,
                                        "refresh":  1
                                    }
                                ]
                   },
    "panels":  [
                   {
                       "id":  1,
                       "title":  "Toplam Read (fleet)",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  6,
                                       "x":  0,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "pgstat"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "bytes",
                                                            "decimals":  1
                                                        }
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         }
                                   },
                       "targets":  [
                                       {
                                           "rawSql":  "select coalesce(sum(d.reads_delta) * 8192, 0) as value from fact.pg_io_stat_delta d join control.instance_inventory i on i.instance_pk = d.instance_pk where $__timeFilter(d.sample_ts) and (i.instance_pk::text in ($instance) or \u0027All\u0027 in ($instance)) and (i.service_group in ($service_group) or \u0027All\u0027 in ($service_group) or i.service_group is null)",
                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  2,
                       "title":  "Toplam Write (fleet)",
