                                           "format":  "table"
                                       }
                                   ]
                   },
                   {
                       "id":  4,
                       "title":  "Toplam Fsync (fleet)",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  4,
                                       "w":  6,
                                       "x":  18,
